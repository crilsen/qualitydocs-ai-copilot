# Copy to .env and fill in. Never commit .env with real keys.
# Provider selection: auto | anthropic | openai | gemini | compat | local
LLM_PROVIDER=auto

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# OpenAI (GPT / Codex models)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (either variable works)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI-compatible endpoint: OpenCode gateway, OpenRouter, Ollama, vLLM, ...
COMPAT_BASE_URL=
COMPAT_API_KEY=
COMPAT_MODEL=

DATABASE_URL=sqlite:///./app.db
MAX_UPLOAD_MB=15
ALLOWED_EXTENSIONS=.pdf,.docx
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
